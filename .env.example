# Copy to .env (git-ignored); just loads it for every recipe. All optional.

# Another machine for the heavy recipes: just remote test, just remote uitest (user@host:path, the parent folder:
# the checkout goes to path/ferrite, ../docs and ../testdata beside it)
FERRITE_REMOTE=

# The radio when none is named: a port (/dev/cu.usbserial-1420, ble:ID, tcp:127.0.0.1:7300) or a name from radios.toml.
# Unset: radios.toml's default, then the only cable plugged in.
FERRITE_PORT=

# Your radios by name (default ~/.config/ferrite/radios.toml; the format: radios.example.toml)
FERRITE_RADIOS=

# just flash without radios.toml: the build (receive, tx, tx-bench) and the radio's whole-chip backup
FERRITE_BUILD=tx
FERRITE_BACKUP=
